# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Admin Notifications
ADMIN_EMAIL=sacrednational@majmau.com

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Meal to Smile" <your-email@gmail.com>

# Firebase Firestore Configuration
# Option 1: Path to serviceAccountKey.json file relative to backend or absolute path
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
# Option 2: Firebase project ID (uses Application Default Credentials if key path not set)
FIREBASE_PROJECT_ID=meal-to-smile-project
